{
  "name": "clearner",
  "version": "1.0.0",
  "description": "Intelligent disk space recovery tool - Find and safely delete leftover data from uninstalled apps",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "init-db": "node scripts/init-database.js",
    "postinstall": "electron-rebuild",
    "rebuild": "electron-rebuild"
  },
  "keywords": [
    "disk",
    "cleanup",
    "space",
    "recovery",
    "uninstall",
    "residue",
    "safe",
    "delete"
  ],
  "author": "Clearner Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "fast-glob": "^3.3.2",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.clearner.app",
    "productName": "Clearner",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/signatures.db",
        "to": "data/signatures.db"
      }
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  }
}